{
	"name": "SERGULATH virtual controller (legacy apps)",
	"controller_type": "sergulath_controller",
	"description": "Maps the virtual controller to the legacy button bits that OpenVR apps read with GetControllerState: trigger (axis 1 and k_EButton_SteamVR_Trigger), grip, application menu and system.",
	"bindings": {
		"/actions/legacy": {
			"poses": [
				{ "output": "/actions/legacy/in/Left_Pose", "path": "/user/hand/left/pose/raw" },
				{ "output": "/actions/legacy/in/Right_Pose", "path": "/user/hand/right/pose/raw" }
			],
			"sources": [
				{ "mode": "button", "path": "/user/hand/left/input/trigger", "inputs": { "click": { "output": "/actions/legacy/in/left_axis1_press" } } },
				{ "mode": "button", "path": "/user/hand/right/input/trigger", "inputs": { "click": { "output": "/actions/legacy/in/right_axis1_press" } } },
				{ "mode": "button", "path": "/user/hand/left/input/grip", "inputs": { "click": { "output": "/actions/legacy/in/left_grip_press" } } },
				{ "mode": "button", "path": "/user/hand/right/input/grip", "inputs": { "click": { "output": "/actions/legacy/in/right_grip_press" } } },
				{ "mode": "button", "path": "/user/hand/left/input/application_menu", "inputs": { "click": { "output": "/actions/legacy/in/left_applicationmenu_press" } } },
				{ "mode": "button", "path": "/user/hand/right/input/application_menu", "inputs": { "click": { "output": "/actions/legacy/in/right_applicationmenu_press" } } },
				{ "mode": "button", "path": "/user/hand/left/input/system", "inputs": { "click": { "output": "/actions/legacy/in/left_system_press" } } },
				{ "mode": "button", "path": "/user/hand/right/input/system", "inputs": { "click": { "output": "/actions/legacy/in/right_system_press" } } }
			]
		}
	}
}
